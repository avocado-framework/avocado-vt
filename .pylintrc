[MASTER]
# Prefer adjacent source checkouts, with CI-installed dependencies as fallback.
init-hook=import sys; from pathlib import Path; root = Path.cwd(); sys.path[:0] = [str(path) for path in (root, root.parent / "avocado", root.parent / "aexpect", root.parent / "guibot", root / ".pylint-dependencies") if path.is_dir()]

# Exclude files or directories from linting
ignore=avocado-libs,cache_populate.py,example.py,github_issues.py,label_issues.py,pulls_applied.py,stale_pulls.py,unassigned_issues.py

# Add files or directories matching the regex patterns to the blacklist
ignore-patterns=.git

[MESSAGES CONTROL]
# Disable specific error codes from pylint command:
# W (warning), R (refactor), C (convention), and specific codes
disable=W,R,C,E0203,E0601,E0606,E0611,E1002,E1101,E1102,E1103,E1120,E1200,E1201,F0401,I0011,E1003,W605,I1101
